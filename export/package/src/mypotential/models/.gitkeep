# This directory contains pre-compiled model files:
# - model_cpu.vmfb    (CPU backend)
# - model_cuda.vmfb   (CUDA backend)
# - model_vulkan.vmfb (Vulkan backend)
# - params.npz        (Model parameters)
# - metadata.json     (Model metadata)
#
# These files are generated by the export pipeline.
# See scripts/export_from_julia.jl and scripts/compile_model.py
