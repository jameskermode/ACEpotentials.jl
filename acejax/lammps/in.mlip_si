# Si ACE bundle under pair_style jax/kk.
#   lmp -k on g 1 -sf kk -pk kokkos newton on neigh half gpu/aware off \
#     -var pjrt /abs/xla_cuda_plugin.so -var bundle si_ace.lammps-jax.json -in in.mlip_si
#
# Geometry comes from si.data (built by in.si_setup) so that 1-rank and 2-rank
# runs evaluate an identical system.
# steps=0 dumps frame-0 forces; steps>0 runs NVE at 300 K.

variable bundle index si_ace.lammps-jax.json
variable steps index 0
variable dump_path index si_static.dump
variable datafile index si.data

units metal
atom_style atomic
boundary p p p
newton on

read_data ${datafile}

neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes one 512 page 500000

pair_style jax/kk ${pjrt}
pair_coeff * * ${bundle}

thermo 20
thermo_style custom step atoms pe press
thermo_modify norm no format float %.16g

if "${steps} == 0" then &
  "dump forces all custom 1 ${dump_path} id type x y z fx fy fz" &
  "dump_modify forces sort id format float %.16g first yes" &
else &
  "velocity all create 300.0 87287 loop geom" &
  "fix 1 all nve"

run_style verlet/kk
run ${steps}
