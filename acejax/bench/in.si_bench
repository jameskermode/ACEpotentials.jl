# Si diamond supercell benchmark deck.
#   -var reps N   cells per side (N=2 -> 64 atoms, N=10 -> 8000)
#   -var style    jax | pace | eam
#   -var steps    MD steps to time
variable reps  index 3
variable steps index 20
variable style index jax

units metal
atom_style atomic
boundary p p p
newton on

lattice diamond 5.43
region box block 0 ${reps} 0 ${reps} 0 ${reps}
create_box 1 box
create_atoms 1 box
mass 1 28.0855
displace_atoms all random 0.05 0.05 0.05 12345 units box

# nevery/ncheck are variables so a run can be forced to reneighbour every step
# or never, which is what separates "aborts after N steps" from "aborts after
# N neighbour-list rebuilds".
variable nevery index 1
variable ncheck index yes
neighbor 1.0 bin
neigh_modify every ${nevery} delay 0 check ${ncheck} one 2000 page 2000000

if "${style} == jax" then &
  "pair_style jax/kk ${pjrt}" &
  "pair_coeff * * ${bundle}"
if "${style} == pace" then &
  "pair_style pace/kk product" &
  "pair_coeff * * ${yace} Si"
# Scale anchor: Stillinger-Weber Si.  Same element and structure, but classical
# 3-body physics rather than ML -- included for scale, not as a like-for-like
# comparison.
if "${style} == sw" then &
  "pair_style sw/kk" &
  "pair_coeff * * ${swfile} Si"

# timestep 0.0 freezes the configuration: LAMMPS still evaluates forces every
# step, so `run N` is N repeated single-point evaluations.  This measures the
# pair style and the model without the Si_tiny potential's missing repulsive
# core letting atoms collapse.
#
# CAVEAT, stated here and in results.md: with atoms static, `check yes` never
# triggers a neighbour-list rebuild, so these numbers EXCLUDE reneighbouring
# cost, which real MD pays periodically.
velocity all create 300.0 87287 loop geom
fix 1 all nve
timestep 0.0
variable thermo_n index 1000
thermo ${thermo_n}
thermo_style custom step atoms pe
thermo_modify norm no format float %.10g
run_style verlet/kk
run ${steps}
